{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kiseki",
  "version": "0.1.0",
  "identifier": "app.kiseki.desktop",
  "build": {
    "frontendDist": "../splash",
    "devUrl": "http://127.0.0.1:3000"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../staging/runtime/": "runtime/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
