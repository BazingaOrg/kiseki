{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "remotion.config.ts"],
  "exclude": ["src/filters.test.ts", "src/fontLoadPlan.test.ts", "src/motion.test.ts", "src/subtitle.test.ts", "src/templates.test.ts"]
}
