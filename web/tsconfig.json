{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "allowJs": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  // 测试用 node --experimental-strip-types 直接跑,带 .ts 后缀的 import 不合 bundler 解析,
  // 与 renderer/tsconfig.json 排除 filters.test.ts 是同一处理
  "exclude": ["src/capabilities.test.ts", "src/command.test.ts"],
  "references": [{"path": "./tsconfig.node.json"}]
}
